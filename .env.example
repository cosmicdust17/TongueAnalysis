# python scripts/configure.py generates real local secrets without overwriting an existing .env.
APP_ENV=development
DATABASE_URL=mysql+pymysql://tongue_app:REPLACE_PASSWORD@127.0.0.1:3306/tongue_analysis?charset=utf8mb4
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TOKEN_HOURS=12
DEV_LOGIN_ENABLED=true
AUTO_CREATE_SCHEMA=false
WORKER_ENABLED=true
GRAPH_PROVIDER=neo4j
KNOWLEDGE_RETRIEVAL_ENABLED=false
RETRIEVAL_GRAPH_BASE_URL=
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_PASSWORD
NEO4J_DATABASE=neo4j
MODEL_PROVIDER=mock
MODEL_BASE_URL=http://127.0.0.1:8001
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=120
WECHAT_APPID=
WECHAT_SECRET=
UPLOAD_MAX_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MYSQL_PASSWORD=REPLACE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_ROOT_PASSWORD
